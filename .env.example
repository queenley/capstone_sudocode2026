# Local Compose defaults. Change all secrets before deployment.
POSTGRES_PASSWORD=local-postgres-change-me
APP_SECRET=local-development-secret-change-before-deploy
ENCRYPTION_KEY=
ADMIN_TOKEN=local-admin-change-me
AGENT_TOKEN=local-agent-change-me
SELLER_TOKEN=local-seller-change-me
DEVELOPER_TOKEN=local-developer-change-me
ENVIRONMENT=development
# AI agent (apps/ai-agent-service/config/models.yaml names the models).
# A provider is offered only when its key is set; Jev (the policy guard)
# goes through the Vercel AI Gateway key.
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Shop contact shown on the website
HOTLINE_NUMBER=1900 6868
# Voice calls (web call button and hotline). 1 builds the agent with speech recognition.
AGENT_WITH_VOICE=1
# Who speaks the answers: openai:<voice> (cloud, ~1 s per sentence, paid, uses OPENAI_API_KEY;
# coral, nova, sage, shimmer) or vieneu: (local CPU, free, 10+ s per sentence on 4 CPUs,
# downloads ~1.4 GB on first use). Changing between them: docker compose up -d --build ai-agent-service
VOICE_TTS=openai:coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS=elevenlabs: speaks with the agent voices of scripts/create_data/config/voices.yaml,
# picked by the caller's region in the CRM (bac/trung/nam); an unknown caller hears VOICE_DEFAULT_REGION.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICE_GENDER=female
VOICE_DEFAULT_REGION=bac
# Speech recognition (apps/asr-service). Empty ASR_URL: the asr-service container on this machine.
# A GPU host elsewhere: ASR_URL=https://<host>:8500, ASR_API_KEY=<long random>, ASR_LOCAL=0.
ASR_URL=
ASR_API_KEY=
ASR_LOCAL=1
ASR_PRELOAD=zipformer-30m
# Bank transfer payments (VietQR). BANK_BIN: the bank's VietQR id, e.g. 970436 = Vietcombank. Empty: COD only.
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# Zalo Official Account (see docs/channels.md). Leave empty to hide Zalo.
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_WEBHOOK_INSECURE=0
GROQ_API_KEY=
NVIDIA_API_KEY=
# Jev (soft guard), used by evaluators.policy in apps/ai-agent-service/config/models.yaml:
# directly from TypeSafe (default) or through Vercel AI Gateway (needs paid credits).
TYPESAFE_API_KEY=
JEV_URL=https://api.typesafe.ai/v1/systemone
AI_GATEWAY_API_KEY=
AGENT_DB_SCHEMA=agent
# Langfuse (optional): traces model calls, a summary per agent turn, and evaluation spend.
# BASE_URL e.g. https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
# Leave empty for transactional local worker. Use kafka:9092 with --profile async.
KAFKA_BROKERS=
KAFKA_LEGACY_TOPIC_MIRROR=true
# Optional semantic knowledge retrieval. Lexical retrieval works without these.
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
OTEL_EXPORTER_OTLP_ENDPOINT=
# For a managed Redis TLS endpoint, mount its CA certificate and set this path.
REDIS_CA_CERTS=
