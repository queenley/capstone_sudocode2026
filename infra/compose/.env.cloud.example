# .env for the cloud stack (infra/compose/docker-compose.cloud.yml) on one server: copy to .env and fill in.
#   docker compose -f docker-compose.yml -f infra/compose/docker-compose.cloud.yml up -d --build
# Generate the random values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# and ENCRYPTION_KEY with:          python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Required: the stack refuses to start without these ──────────────────────
DOMAIN=shop.example.com            # a DNS A record of this name -> this server; ports 80 and 443 open
POSTGRES_PASSWORD=
APP_SECRET=                        # 32+ random bytes; changing it later makes stored PII unreadable
ENCRYPTION_KEY=                    # Fernet key
ADMIN_TOKEN=                       # four different values, 32+ characters each
AGENT_TOKEN=
SELLER_TOKEN=
DEVELOPER_TOKEN=
HOTLINE_BRIDGE_KEY=

# production: strong secrets checked, OTP only through an SMS provider (below).
# staging: the same stack for a demo, with the one-time code shown on screen.
ENVIRONMENT=production
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=

# ── The assistant's models ─────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
TYPESAFE_API_KEY=
JEV_URL=https://api.typesafe.ai/v1/systemone

# ── Voice calls ────────────────────────────────────────────────────────────
# Spoken by a cloud voice: openai:coral (OPENAI_API_KEY) or elevenlabs: (by the caller's region).
VOICE_TTS=openai:coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICE_GENDER=female
VOICE_DEFAULT_REGION=bac
# Recognised on a GPU host (apps/asr-service/Dockerfile.gpu): its address and key.
ASR_URL=https://asr.example.com
ASR_API_KEY=
# 1: run asr-service on this server's CPU instead (then leave ASR_URL empty).
ASR_LOCAL=0

# ── Channels ───────────────────────────────────────────────────────────────
HOTLINE_NUMBER=1900 6868
# Zalo OA: webhook https://$DOMAIN/api/channels/zalo/webhook
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=
# Phone line (--profile hotline): LiveKit keys, the SIP trunk; UDP 5060, 40000-40100, 40200-40300 open.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                # 32+ characters
SIP_TRUNK_ID=

# ── Optional ───────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
