# Copy to backend.hcl, then: terraform init -backend-config=backend.hcl (a key of its own: never the EC2 stack's state)
bucket       = "your-terraform-state-bucket"   # versioning on, made once by hand
key          = "telesales/aws-eks/production.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true                            # S3-native locking, no DynamoDB table
