# Copy to terraform.tfvars (not committed: *.tfvars is in .gitignore) and fill in.
domain            = "shop.example.com"
hosted_zone_id    = ""                      # Route 53 zone id; empty: DNS records by hand (outputs)
github_repository = "your-org/your-repo"
tf_state_bucket   = "your-terraform-state-bucket"
alarm_email       = ""
