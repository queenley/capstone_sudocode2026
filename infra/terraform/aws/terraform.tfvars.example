# Copy to terraform.tfvars (not committed: *.tfvars is in .gitignore) and fill in.
domain            = "shop.example.com"
hosted_zone_id    = ""                      # Route 53 zone id; empty: DNS records by hand (outputs)
github_repository = "your-org/your-repo"
tf_state_bucket   = "your-terraform-state-bucket"
alarm_email       = ""
# region           = "ap-southeast-1"
# Default: one CPU host (t3.xlarge), PostgreSQL in a container on an EBS data volume, about 215 USD/month.
# instance_type    = "t3.xlarge"
# data_volume_gb   = 30
# backup_retention_days = 7
# Later, with RDS and two instances (move the data first: aws-terraform-cicd.md section 10):
# use_rds          = true
# instance_type    = "r7i.large"
# asg_min          = 2
# asg_max          = 4
# db_multi_az      = false
# improve_schedule_enabled = false          # true spends model calls every week
