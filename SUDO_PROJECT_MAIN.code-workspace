			"**/asr/models/**": true,
			"**/asr/datasets/**": true,
			"**/runs/**": true,
			"**/output/**": true
		}
	},
	"extensions": {
		"recommendations": [
			"yzhang.markdown-all-in-one",
			"shd101wyy.markdown-preview-enhanced",
			"davidanson.vscode-markdownlint",
			"pomdtr.excalidraw-editor",
			"tomoki1207.pdf"
		]
	}
