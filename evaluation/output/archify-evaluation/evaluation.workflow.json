  "cards": [
    {
      "dot": "amber",
      "title": "Source Gate — thiết kế nhóm",
      "items": [
        "Quyết định nguồn có được dùng để học hay chỉ báo cáo; không phải cổng nhập Frozen hoặc kiểm giá.",
        "Nguồn bị chặn / chưa rõ quyền: report hoặc review, không tạo candidate tự động."
      ]
    },
    {
      "dot": "violet",
      "title": "Bốn cơ chế dùng chung đường duyệt",
      "items": [
        "Knowledge Gap: câu chưa trả lời → Consultant → FAQ nháp + Growth test.",
        "Reflection: record mỗi call; bài học được phép → pool → playbook.",
        "Exemplar: chỉ ví dụ đã xác minh → candidate → duyệt → evaluation.",
        "M2 A/B: duyệt protocol → chạy hai nhánh state riêng → đề xuất winner; winner vẫn phải qua release gate."
      ]
    },
    {
      "dot": "cyan",
      "title": "15 — hợp đồng kiểm chứng",
      "items": [
        "Giữ Frozen và cấu hình cố định; full / baseline chỉ khác quyền đọc memory hội thoại phiên trước.",
        "M1: assertion, metrics, ASR, latency; M2 thêm các suite áp dụng. Simulator tách fixed-turn.",
        "Thiếu evidence không thành PASS; hard FAIL vẫn giữ. Candidate đổi sau đo phải duyệt / đo lại."
      ]
    },
    {
      "dot": "emerald",
      "title": "16 — sử dụng và rollback",
      "items": [
        "Chỉ bản đã duyệt, đo đúng hash mới active; có version và rollback.",
        "Customer ledger không phải kho bài học dùng chung. Không đưa PII vào FAQ / few-shot.",
        "Đây là sơ đồ thiết kế, không chứng minh Agent đã triển khai hoặc chạy đạt."
      ]
    }
  ]
