  "cards": [
    {
      "dot": "cyan",
      "title": "Đầu vào và phép so công bằng",
      "items": [
        "Frozen + grading contract; cấu hình, KB, catalog/policy snapshot và seed nghiệp vụ giữ nguyên.",
        "Full và baseline có state riêng; baseline chỉ chặn đọc memory hội thoại phiên trước, không bỏ working memory.",
        "Chạy call đúng ngày; chờ after-call trước call sau. Input ASR lỗi được giữ theo scenario."
      ]
    },
    {
      "dot": "violet",
      "title": "Scorer BTC và kiểm tra bổ sung",
      "items": [
        "Questions: RQR; facts_used/tool args: CCR; claims so GT: HR; success_if: TSR và TSR ca khó.",
        "Giữ report reference_eval.py nguyên bản. Kiểm value, tool result, brief schema, memory/PII và chất lượng báo riêng.",
        "Judge chọn J01–J12 theo applicability; không thay assertion FAIL bằng judge PASS. Hybrid AND là thiết kế nhóm."
      ]
    },
    {
      "dot": "amber",
      "title": "ASR / M2 tách cohort",
      "items": [
        "ASR: audio + transcript/entity GT → local ASR → raw + normalize WER/CER; ITN tiền/SĐT riêng.",
        "M2: diarization turn accuracy (không DER), RAG retrieval/abstain + answer/version, simulator 3 seed; không gộp fixed-turn.",
        "M2 còn Tool-Call Accuracy, TTFA, ≥2 phiên đồng thời, judge/human agreement. Suite M2 không chặn M1 khi không áp dụng."
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence thiếu không được biến thành PASS",
      "items": [
        "Schema/ID/hash và expected/observed call/turn/audio/qid được kiểm trước chấm; vẫn giữ hard FAIL đã chứng minh.",
        "Thiếu GT, baseline RQR=0 hoặc mẫu số=0 báo N/A / INCOMPLETE, không tự đạt ngưỡng.",
        "Latency derived bỏ 3 warm-up; quality giữ mọi turn. Candidate/model version được ghim cho phép so."
      ]
    },
    {
      "dot": "emerald",
      "title": "Đọc và nguồn",
      "items": [
        "Thiết kế theo Evaluation_QD (1).md, evaluation-runner-flow.md và evaluation-flow.md; không phải benchmark đã chạy.",
        "Nguồn BTC: DIEU-CHINH-DE.md; eval/reference_eval.py; eval/llm_judge_rubric.json; schemas/; catalog/; policy/; asr/; rag/; simulator/.",
        "Chỉ mô tả hệ thống đánh giá, không có Source Gate học, FAQ candidate hay release. UI Archify tiếng Anh, nội dung tiếng Việt."
      ]
    }
  ]
