  "components": {
    "schemas": {
      "FeedbackInput": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "title": "Category",
            "default": "general"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HumanMessage": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "HumanMessage"
      },
      "NewConversation": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "web",
              "chat",
              "call",
              "hotline",
              "fanpage",
              "zalo"
            ],
            "title": "Channel",
            "default": "web"
          }
        },
        "type": "object",
        "title": "NewConversation"
      },
      "OrderInput": {
        "properties": {
          "items": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/OrderLine"
                },
                "type": "array",
                "maxItems": 20,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Items"
          },
          "sku_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku Code"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "expected_unit_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Unit Price"
          },
          "shipping_address": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Shipping Address"
          },
          "expected_total": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Expected Total"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "payment_method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cod",
                  "bank_transfer"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method"
          }
        },
        "type": "object",
        "required": [
          "shipping_address",
          "expected_total",
          "confirmed",
          "idempotency_key"
        ],
        "title": "OrderInput",
        "description": "One order: several lines in ``items``, or one line in the older flat form\n(``sku_code``, ``quantity``, ``expected_unit_price``)."
      },
      "OrderLine": {
        "properties": {
          "sku_code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Sku Code"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "expected_unit_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Expected Unit Price"
          }
        },
        "type": "object",
        "required": [
          "sku_code",
          "quantity",
          "expected_unit_price"
        ],
        "title": "OrderLine"
      },
      "ReviewInput": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision"
          },
          "knowledge_text": {
            "type": "string",
            "maxLength": 10000,
            "title": "Knowledge Text",
            "default": ""
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "title": "Category",
            "default": "faq"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ReviewInput"
      },
      "TransferInput": {
        "properties": {
          "to_actor_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Actor Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "TransferInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}