        "tags": [
          "developer"
        ],
        "summary": "Latency",
        "description": "p50 and p95 of the organisers' four figures over agent turns, warm-up excluded.",
        "operationId": "latency_api_developer_latency_get",
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "web",
                "zalo",
                "hotline",
                "facebook"
              ],
              "type": "string",
              "default": "all",
              "title": "Channel"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 90,
              "minimum": 1,
              "default": 7,
