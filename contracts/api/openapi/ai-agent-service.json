    "/api/developer/calls/{call_id}/trace": {
      "get": {
        "tags": [
          "developer"
        ],
        "summary": "Call Trace",
        "description": "One stored call as the organisers' ``trace_log`` rows, labelled with the scenario it played.\n\n``json`` returns the rows with each one's violations of\n``schemas/trace_log.schema.json``; ``jsonl`` is the file ``reference_eval.py\n--trace`` reads (append the calls of a run together).",
        "operationId": "call_trace_api_developer_calls__call_id__trace_get",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Call Id"
            }
          },
          {
            "name": "scenario_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Scenario Id"
            }
          },
          {
            "name": "call",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "call_1",
                "call_2",
                "call_3"
              ],
              "type": "string",
              "default": "call_1",
              "title": "Call"
            }
          },
          {
            "name": "config",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "full",
                "baseline_no_memory"
              ],
              "type": "string",
              "default": "full",
              "title": "Config"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "default": "run",
              "title": "Run Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "json",
                "jsonl"
              ],
              "type": "string",
              "default": "json",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
