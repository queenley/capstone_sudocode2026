  "components": {
    "schemas": {
      "AdvisorUpdate": {
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          }
        },
        "type": "object",
        "title": "AdvisorUpdate"
      },
      "BusinessDay": {
        "properties": {
          "day": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day",
            "description": "YYYY-MM-DD; empty returns to the reference day"
          }
        },
        "type": "object",
        "title": "BusinessDay"
      },
      "ConsultantReply": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          },
          "action": {
            "type": "string",
            "enum": [
              "used",
              "edited",
              "own"
            ],
            "title": "Action",
            "default": "own"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ConsultantReply"
      },
      "FaqEntry": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "FaqEntry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffRequest": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "title": "HandoffRequest"
      },
      "ModelSelection": {
        "properties": {
          "provider": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "title": "ModelSelection"
      },
      "TurnRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "selected_sku": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Sku"
          },
          "memory_enabled": {
            "type": "boolean",
            "title": "Memory Enabled",
            "default": true
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "TurnRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoiceUpdate": {
        "properties": {
          "asr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asr"
          },
          "endpointing": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endpointing"
          },
          "barge_in_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2000.0,
                "minimum": 100.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Barge In Ms"
          },
          "min_interruption_words": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 6.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Interruption Words"
          },
          "tts": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tts"
          },
          "reset": {
            "type": "boolean",
            "title": "Reset",
            "default": false
          }
        },
        "type": "object",
        "title": "VoiceUpdate"
      }
    }
  }
}