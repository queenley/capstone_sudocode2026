  "components": {
    "schemas": {
      "CartInput": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartLineInput"
            },
            "type": "array",
            "maxItems": 60,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CartInput"
      },
      "CartLineInput": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Sku"
          },
          "qty": {
            "type": "integer",
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Qty"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "qty"
        ],
        "title": "CartLineInput"
      },
      "CodeInput": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "code": {
            "type": "string",
            "maxLength": 10,
            "minLength": 4,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "CodeInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identification": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ],
            "title": "Kind"
          },
          "value": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Value"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "value",
          "consent"
        ],
        "title": "Identification"
      },
      "PasswordChange": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 128,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange"
      },
      "PhoneInput": {
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 6,
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "PhoneInput"
      },
      "ProfileInput": {
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "title": "ProfileInput"
      },
      "Registration": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name"
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 6,
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "full_name",
          "phone",
          "password"
        ],
        "title": "Registration"
      },
      "ResetInput": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "code": {
            "type": "string",
            "maxLength": 10,
            "minLength": 4,
            "title": "Code"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "code",
          "password"
        ],
        "title": "ResetInput"
      },
      "StaffInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 12,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "agent",
              "admin",
              "seller",
              "developer"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "role"
        ],
        "title": "StaffInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verification": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          },
          "full_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Full Name",
            "default": ""
          },
          "customer_token": {
            "type": "string",
            "maxLength": 200,
            "title": "Customer Token",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "Verification"
      },
      "src__api__routes__customer__LoginInput": {
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "title": "LoginInput"
      },
      "src__api__schemas__LoginInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginInput"
      }
    }
  }
}