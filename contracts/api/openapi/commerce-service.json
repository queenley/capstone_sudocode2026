  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProductInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "maxLength": 100,
            "title": "Brand",
            "default": ""
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Category"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "sku_code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Sku Code"
          },
          "variant": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Variant"
          },
          "list_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "List Price"
          },
          "sale_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Sale Price"
          },
          "stock": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Stock"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "sku_code",
          "list_price",
          "sale_price",
          "stock"
        ],
        "title": "ProductInput"
      },
      "PromotionInput": {
        "properties": {
          "sku_code": {
            "type": "string",
            "title": "Sku Code"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          },
          "promotion_type": {
            "type": "string",
            "enum": [
              "fixed",
              "percent",
              "informational"
            ],
            "title": "Promotion Type"
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "starts_at": {
            "type": "string",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "title": "Ends At"
          }
        },
        "type": "object",
        "required": [
          "sku_code",
          "channel",
          "name",
          "description",
          "promotion_type",
          "starts_at",
          "ends_at"
        ],
        "title": "PromotionInput"
      },
      "StockInput": {
        "properties": {
          "quantity_on_hand": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Quantity On Hand"
          }
        },
        "type": "object",
        "required": [
          "quantity_on_hand"
        ],
        "title": "StockInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}